# =============================================================================
# MYSTES — Environment Variables Template
# Copy to .env and fill in your values
# =============================================================================

# --- Core ---
FLASK_ENV=development                    # development | production
SECRET_KEY=change-me-to-a-random-string  # REQUIRED in production
BASE_URL=http://localhost:5001           # Public URL (used in emails, callbacks)

# --- Database ---
DATABASE_URL=sqlite:///mystes.db         # SQLite for dev; PostgreSQL for prod
# DATABASE_URL=postgresql://user:pass@localhost:5432/mystes_db

# --- Redis (Celery, rate limiting, SSE) ---
REDIS_URL=redis://localhost:6379/0
RATELIMIT_STORAGE_URL=memory://          # Use redis://... in production
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3

# --- Stripe (Payments) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Travel+ Subscription Stripe Price IDs
TRAVEL_PLUS_MONTHLY_STRIPE_PRICE_ID=price_...
TRAVEL_PLUS_ANNUAL_STRIPE_PRICE_ID=price_...

# B2B Subscription Stripe Price IDs
B2B_STARTER_STRIPE_PRICE_ID=price_...

# Dev Portal Subscription Stripe Price IDs
DEV_PORTAL_PAYG_STRIPE_PRICE_ID=price_...
DEV_PORTAL_BUILDER_STRIPE_PRICE_ID=price_...
DEV_PORTAL_SCALE_STRIPE_PRICE_ID=price_...

# --- Email (SMTP) ---
MAIL_ENABLED=false                       # Set true in production
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com       # Must match sender for SPF/DKIM
MAIL_PASSWORD=your-app-password          # Gmail: use App Password, not account password
MAIL_DEFAULT_SENDER=MYSTES <your-email@gmail.com>

# --- AI (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...             # Required for Dev Portal + AI chat

# --- Flight Search: Picasso/Redbox (AERTiCKET GDS) ---
PICASSO_USERNAME=
PICASSO_PASSWORD=
PICASSO_TOTP_SECRET=
PICASSO_SESSION_TOKEN=
PICASSO_REDBOX_URL=https://aerpackit.flightconex.de/redbox
PICASSO_COCKPIT_URL=https://cockpit.thegoodconsolidator.com
PICASSO_AGENCY_ID=629818
PICASSO_BRANCH=PICL_707

# --- Flight Search: Duffel (NDC) ---
DUFFEL_ACCESS_TOKEN=duffel_test_...

# --- Flight Search: Kiwi (Tequila) ---
KIWI_API_KEY=

# --- Flight Search: AirGateway (NDC) ---
AIRGATEWAY_API_KEY=

# --- Hotels: liteAPI ---
LITEAPI_KEY=

# --- Cars: Discover Cars ---
DISCOVER_CARS_API_KEY=

# --- Activities: Viator ---
VIATOR_API_KEY=

# --- Insurance: SafetyWing ---
SAFETYWING_API_KEY=
SAFETYWING_ENV=sandbox                   # sandbox | production

# --- CORS ---
CORS_ALLOWED_ORIGINS=                    # Comma-separated: https://mystes.app,https://www.mystes.app

# --- Proxy (Market-Specific Pricing) ---
JP_PROXY_URL=
US_PROXY_URL=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- MoonPay (Crypto Ramp) ---
MOONPAY_API_KEY=
MOONPAY_SECRET_KEY=
