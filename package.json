{
  "name": "mystes-app",
  "version": "1.0.0",
  "description": "MYSTES — Break free from borders. Global flight prices, crypto payments, XRPL powered.",
  "main": "server.py",
  "scripts": {
    "cap:init": "npx cap init mystes-app com.mystes.app --web-dir static",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "cap:build": "npx cap sync && echo 'Ready — open Xcode or Android Studio to build'"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.0",
    "@capacitor/browser": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/ios": "^6.2.1",
    "@capacitor/keyboard": "^6.0.0",
    "@capacitor/local-notifications": "^6.0.0",
    "@capacitor/push-notifications": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@capawesome-team/capacitor-android-foreground-service": "^6.2.0",
    "@capawesome/capacitor-background-task": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "typescript": "^5.9.3"
  }
}
