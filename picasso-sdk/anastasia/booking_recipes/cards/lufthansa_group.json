{
  "recipe_id": "lufthansa_group",
  "airline_group": "Lufthansa Group",
  "airlines": ["LH", "LX", "OS", "SN", "EW"],
  "base_url": "https://api-shop.lufthansa.com",
  "language_path": "/lh/us/en/",

  "session_setup": {
    "description": "Navigate to shop SPA homepage, extract session tokens from sessionStorage.",
    "spa_url": "https://shop.lufthansa.com/${language_path}homepage",
    "wait_after_load_ms": 8000,
    "cookie_consent_selector": "#cm-acceptAll",
    "token_extraction": {
      "method": "page_evaluate",
      "script": "async () => { try { const d = JSON.parse(sessionStorage.getItem('gateway-auth-tokens')); for (const v of Object.values(d)) if (v.token) return v.token; } catch(e) {} const r = await fetch('https://api-shop.lufthansa.com/v1/oauth2/token', { method: 'POST', headers: {'Content-Type': 'application/x-www-form-urlencoded'}, body: 'client_id=k7zpj4s6k2qbrr4xhrzqa7yn&client_secret=rVXq%2305&fact=%7B%7D&grant_type=client_credentials' }); return (await r.json()).access_token; }",
      "extract_variable": "access_token"
    },
    "ama_client_ref_extraction": {
      "method": "page_evaluate",
      "script": "() => sessionStorage.getItem('Ama-Client-Ref')",
      "extract_variable": "ama_client_ref"
    },
    "variables": {
      "access_token": null,
      "ama_client_ref": null
    },
    "oauth2": {
      "token_url": "https://api-shop.lufthansa.com/v1/oauth2/token",
      "grant_type": "client_credentials",
      "client_id": "k7zpj4s6k2qbrr4xhrzqa7yn",
      "content_type": "application/x-www-form-urlencoded",
      "body_template": "client_id=${client_id}&client_secret=rVXq%2305&fact=%7B%7D&grant_type=client_credentials",
      "response_extract": {
        "access_token": "$.access_token"
      }
    }
  },

  "steps": [
    {
      "name": "search_outbound",
      "description": "Search outbound air-bounds (construction mode — one direction per call).",
      "method": "POST",
      "url": "${base_url}/v1/one-booking/search/air-bounds",
      "headers": {
        "Authorization": "Bearer ${access_token}",
        "Content-Type": "application/json",
        "Accept": "application/json",
        "Ama-Client-Ref": "${ama_client_ref}"
      },
      "body": {
        "itineraries": [
          {
            "originLocationCode": "${origin}",
            "destinationLocationCode": "${destination}",
            "departureDateTime": "${departure_date}",
            "isRequestedBound": true
          },
          {
            "originLocationCode": "${destination}",
            "destinationLocationCode": "${origin}",
            "departureDateTime": "${return_date}",
            "isRequestedBound": false
          }
        ],
        "travelers": "${travelers_array}",
        "commercialFareFamilies": ["${commercial_fare_family}"]
      },
      "body_notes": {
        "one_way": "For one-way searches, omit the second itinerary entirely.",
        "travelers_format": "[{\"passengerTypeCode\": \"ADT\"}, {\"passengerTypeCode\": \"CHD\"}]",
        "construction_mode": "Only ONE itinerary may have isRequestedBound=true per request. The SPA calls this endpoint twice — once for outbound, once for inbound."
      },
      "response_extract": {
        "outbound_groups": "$.data.airBoundGroups",
        "outbound_segments": "$.data.segments",
        "outbound_fare_conditions": "$.data.fareConditions",
        "outbound_services": "$.data.services"
      },
      "validation": {
        "status_code": 200,
        "has_field": "data.airBoundGroups"
      },
      "delay_before_ms": 0,
      "optional": false
    },
    {
      "name": "search_inbound",
      "description": "Search inbound air-bounds (flip isRequestedBound to second itinerary).",
      "method": "POST",
      "url": "${base_url}/v1/one-booking/search/air-bounds",
      "headers": {
        "Authorization": "Bearer ${access_token}",
        "Content-Type": "application/json",
        "Accept": "application/json",
        "Ama-Client-Ref": "${ama_client_ref}"
      },
      "body": {
        "itineraries": [
          {
            "originLocationCode": "${origin}",
            "destinationLocationCode": "${destination}",
            "departureDateTime": "${departure_date}",
            "isRequestedBound": false
          },
          {
            "originLocationCode": "${destination}",
            "destinationLocationCode": "${origin}",
            "departureDateTime": "${return_date}",
            "isRequestedBound": true
          }
        ],
        "travelers": "${travelers_array}",
        "commercialFareFamilies": ["${commercial_fare_family}"]
      },
      "response_extract": {
        "inbound_groups": "$.data.airBoundGroups",
        "inbound_segments": "$.data.segments",
        "inbound_fare_conditions": "$.data.fareConditions",
        "inbound_services": "$.data.services"
      },
      "validation": {
        "status_code": 200,
        "has_field": "data.airBoundGroups"
      },
      "delay_before_ms": 500,
      "optional": false
    },
    {
      "name": "search_calendar",
      "description": "Optional: Fetch calendar prices for flexible date view.",
      "method": "POST",
      "url": "${base_url}/v1/one-booking/search/air-calendars",
      "headers": {
        "Authorization": "Bearer ${access_token}",
        "Content-Type": "application/json",
        "Accept": "application/json",
        "Ama-Client-Ref": "${ama_client_ref}"
      },
      "body": {
        "itineraries": [
          {
            "originLocationCode": "${origin}",
            "destinationLocationCode": "${destination}",
            "departureDateTime": "${departure_date}",
            "isRequestedBound": true
          },
          {
            "originLocationCode": "${destination}",
            "destinationLocationCode": "${origin}",
            "departureDateTime": "${return_date}",
            "isRequestedBound": false
          }
        ],
        "travelers": "${travelers_array}",
        "commercialFareFamilies": ["${commercial_fare_family}"]
      },
      "response_extract": {
        "calendar_data": "$.data"
      },
      "validation": {
        "status_code": 200
      },
      "delay_before_ms": 0,
      "optional": true
    }
  ],

  "card_data_wipe": {
    "after_step": "submit_payment",
    "on_failure": true,
    "fields": ["card_number", "card_cvv", "card_exp_month", "card_exp_year"]
  },

  "error_patterns": {
    "04926": {
      "title": "INVALID DATA RECEIVED",
      "detail": "Unexpected attribute in request body",
      "action": "Check body for invalid fields — id, cabin inside itinerary, wrong field names"
    },
    "36917": {
      "title": "INVALID COMMERCIAL FARE FAMILY",
      "detail": "The commercialFareFamilies value is not a recognized code",
      "action": "Use DEMALLFPP/DEPALLFPP/DECALLFPP/DEFALLFPP — NOT 'E'/'ECONOMY'"
    },
    "38411": {
      "title": "INVALID REQUESTED BOUND",
      "detail": "Multiple itineraries have isRequestedBound=true",
      "action": "Only ONE itinerary may have isRequestedBound=true per request"
    },
    "39236": {
      "title": "MISSING COMMERCIAL FARE FAMILY",
      "detail": "commercialFareFamilies field is empty or missing",
      "action": "Add commercialFareFamilies array with at least one valid code"
    },
    "38601": {
      "title": "RESOURCE NOT SUPPORTED",
      "detail": "The air-offers endpoint is blocked for this client configuration",
      "action": "Use air-bounds endpoint instead — air-offers is not available for shop clients"
    },
    "40003": {
      "title": "Incorrect format in field",
      "detail": "commercialFareFamilies must be string array, not object array",
      "action": "Use [\"DEMALLFPP\"] not [{\"code\": \"DEMALLFPP\"}]"
    }
  },

  "metadata": {
    "platform": "Amadeus OneBooking",
    "spa_version": "28.4.0",
    "angular_version": "19.2.19",
    "spa_bundle": "shop.lufthansa.com/statics/applications/booking/dist/28.4.0/main.4ade5f225e73e2b4.js",
    "spa_bundle_size_bytes": 3497240,
    "capture_date": "2026-04-21",
    "capture_iterations": 50,

    "architecture": {
      "cms_domain": "www.lufthansa.com",
      "spa_domain": "shop.lufthansa.com",
      "api_domain": "api-shop.lufthansa.com",
      "api_base_path": "/v1/one-booking/",
      "search_endpoint": "search/air-bounds",
      "calendar_endpoint": "search/air-calendars",
      "offers_endpoint_blocked": "search/air-offers (596 for shop clients)"
    },

    "search_mode": "construction",
    "search_mode_notes": "Lufthansa uses 'construction mode' — search one direction at a time. Each air-bounds call returns fares for the bound with isRequestedBound=true. Round-trip requires 2 API calls.",

    "commercial_fare_families": {
      "DEMALLFPP": {"cabin": "ECONOMY", "letter": "E", "complex": "COMPLEXM"},
      "DEPALLFPP": {"cabin": "PREMIUMECO", "letter": "N", "complex": "COMPLEXP"},
      "DECALLFPP": {"cabin": "BUSINESS", "letter": "B", "complex": "COMPLEXC"},
      "DEFALLFPP": {"cabin": "FIRST", "letter": "F", "complex": "COMPLEXF"}
    },
    "cabin_to_meta_cff": {
      "eco": "DEMALLFPP",
      "ecoPremium": "DEPALLFPP",
      "business": "DECALLFPP",
      "first": "DEFALLFPP"
    },
    "reward_fare_families": {
      "ECONOMY": "CFFECORTW",
      "PREMIUMECO": "CFFPECORTW"
    },

    "passenger_type_codes": ["ADT", "CHD", "INF", "YTH"],
    "travelers_format": "Array of objects with passengerTypeCode field only — no id field",
    "date_format": "YYYY-MM-DD",

    "response_structure": {
      "top_level": "data",
      "bound_groups": "data.airBoundGroups[]",
      "bound_details": "airBoundGroups[].boundDetails",
      "air_bounds": "airBoundGroups[].airBounds[]",
      "prices": "airBounds[].prices.totalPrices[].total",
      "currency": "airBounds[].prices.totalPrices[].currencyCode",
      "price_unit": "cents (EUR)",
      "segments": "data.segments (dictionary of SEG-* objects)",
      "fare_conditions": "data.fareConditions (dictionary of PEN* objects)",
      "services": "data.services (dictionary of service codes)"
    },

    "flight_id_format": "SEG-{carrier}{flight_number}-{origin}{destination}-{date}-{time}",
    "flight_id_example": "SEG-LH411-JFKMUC-2026-05-21-1730",

    "price_fields": {
      "base": "Base fare in cents",
      "total": "Total price in cents (base + taxes)",
      "totalTaxes": "Total tax amount in cents",
      "taxes": "Array of tax breakdowns with code (e.g., YQYR = carrier surcharge)",
      "discount": "Optional — present for unifares with originalTotal"
    },

    "availability_fields": {
      "cabin": "eco | ecoPremium | business | first",
      "bookingClass": "Single letter (Q, H, E, etc.)",
      "statusCode": "HK = confirmed availability",
      "quota": "Number of seats available"
    },

    "fare_family_tiers_observed": {
      "JVAPM1NNLG": "Economy Light (cheapest, isCheapestOffer=true)",
      "JVAPM2NC0E": "Economy Classic",
      "WWMRFICGR": "Economy Flex (unifares, ticketDesignator=DXWW)",
      "JVAPP2NC0E": "Premium Economy Classic",
      "JVAPC2NC0E": "Business Classic",
      "JVAPC4FF0E": "Business Flex"
    },

    "bright_data_config": {
      "zone": "scraping_browser1",
      "protocol": "CDP over WebSocket",
      "requires_residential_ip": true,
      "proxy_type": "residential"
    },

    "known_limitations": [
      "air-offers endpoint returns 'RESOURCE NOT SUPPORTED' for shop client tokens",
      "air-bounds is construction mode only — one bound searched per API call",
      "Token fact variations do not unlock air-offers",
      "Custom headers beyond Authorization/Content-Type/Accept/Ama-Client-Ref cause CORS failure",
      "cabin field inside itinerary objects causes 'Unexpected attribute' error",
      "id field in travelers causes 'Unexpected attribute' error",
      "commercialFareFamilies must be string array, not object array",
      "Prices are returned in EUR cents regardless of POS — currency conversion is SPA-side"
    ],

    "group_airline_domains": {
      "LH": {"cms": "www.lufthansa.com", "shop": "shop.lufthansa.com", "api": "api-shop.lufthansa.com"},
      "LX": {"cms": "www.swiss.com", "shop": "shop.swiss.com", "api": "api-shop.swiss.com"},
      "OS": {"cms": "www.austrian.com", "shop": "shop.austrian.com", "api": "api-shop.austrian.com"},
      "SN": {"cms": "www.brusselsairlines.com", "shop": "shop.brusselsairlines.com", "api": "api-shop.brusselsairlines.com"},
      "EW": {"cms": "www.eurowings.com", "shop": "shop.eurowings.com", "api": "api-shop.eurowings.com"}
    },

    "sample_response_excerpt": {
      "airBoundGroup": {
        "boundDetails": {
          "originLocationCode": "JFK",
          "destinationLocationCode": "MUC",
          "duration": 28200,
          "ranking": 1,
          "segments": [{"flightId": "SEG-LH411-JFKMUC-2026-05-21-1730", "arrivalDaysDifference": 1}]
        },
        "airBound_cheapest": {
          "airBoundId": "BC1-2-OFR-4881923761856205-1-1-1",
          "fareFamilyCode": "JVAPM1NNLG",
          "isCheapestOffer": true,
          "cabin": "eco",
          "bookingClass": "Q",
          "quota": 9,
          "base_cents": 49800,
          "total_cents": 80712,
          "currency": "EUR",
          "taxes_cents": 30912
        }
      }
    }
  }
}
